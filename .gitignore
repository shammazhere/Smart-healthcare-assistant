# Git ignore patterns for Healthcare Robot project
# ── Virtual Environments
venv/
.venv/
backend/venv/
backend/.venv/
env/
*/venv/
*/.venv/

# ── Build artifacts & Caches
firmware/.pio/
firmware/.vscode/
__pycache__/
backend/__pycache__/
backend/*/__pycache__/
**/__pycache__/
backend/*.pyc
*.pyc
*.pyo
*.pyd

# ── Credentials & Secrets
.env
*.env
backend/.env
*.key
secrets.h

# ── IDE & OS
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# ── Reference Projects
aqms/
