# ============================================================
# .env — Smart Healthcare Assistant Configuration
# Copy this file to backend/.env and add your API keys.
# ============================================================

# ── 1. Speech & Voice: Sarvam AI (Primary) ───────────────────
# Obtain API key from: https://sarvam.ai
# Powers Multilingual Speech-to-Text (saarika:v2) & Text-to-Speech (bulbul:v1/v2)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Path to a reference voice audio sample for custom voice cloning (bulbul:v2)
# SARVAM_CUSTOM_VOICE_SAMPLE=path/to/my_voice_sample.wav

# ── 2. Conversational LLM: Google Gemini (Required) ──────────
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── 3. Patient Records RAG Pipeline ──────────────────────────
# Preloaded SQLite database containing patient records
DEFAULT_PATIENT_ID=patient_001
HEALTH_DB_PATH=backend/data/health.db

# ── 4. Offline / Fallback Engines (No keys required) ─────────
# Fallback STT: faster-whisper (runs locally on CPU)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Fallback TTS: Edge-TTS (Baymax-inspired warm calm voice)
TTS_DEFAULT_VOICE=en-US-AndrewMultilingualNeural
TTS_DEFAULT_RATE=-12%
TTS_DEFAULT_PITCH=-5Hz
