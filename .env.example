# ============================================================
# Smart Healthcare Assistant — Environment Variables Template
# Copy this to .env or configure in Railway Dashboard Variables
# ============================================================

# ── 1. Speech & Voice: Sarvam AI ─────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ── 2. Conversational LLM: Google Gemini ─────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── 3. Patient Records RAG Pipeline ──────────────────────────
DEFAULT_PATIENT_ID=p1
HEALTH_DB_PATH=backend/data/patients.json

# ── 4. Fallback Engine Settings (Optional) ───────────────────
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

TTS_DEFAULT_VOICE=en-US-GuyNeural
TTS_DEFAULT_RATE=-12%
TTS_DEFAULT_PITCH=-5Hz

